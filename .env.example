# Copy this file to .env and edit as needed.
# Production values for Hostinger VPS deployment.

# ---------- Core ----------
APP_NAME=OpenClipboard
CLIP_STORAGE=local          # local | minio
CLIP_DATA_DIR=/app/data
CLIP_DB_BACKEND=sqlite      # sqlite | postgres

# ---------- Upload limits ----------
CLIP_MAX_UPLOAD_MB=100      # Increase for larger files (max 500+ recommended)
CLIP_MIN_TTL=30
CLIP_DEFAULT_TTL=900
CLIP_MAX_TTL=86400
CLIP_PURGE_INTERVAL=30

# ---------- Security ----------
# Allowed hosts (Host header validation). Comma-separated.
# Production: set to your domain(s), e.g. clip.example.com
CLIP_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Allowed CORS origins. Comma-separated. Use "*" for dev, restrict in prod.
CLIP_CORS_ORIGINS=https://yourdomain.com

# Rate limits (slowapi format, e.g. "20/minute") — IP-wise
CLIP_RATE_LIMIT_SEND=20/minute
CLIP_RATE_LIMIT_RETRIEVE=30/minute
CLIP_RATE_LIMIT_FILE=30/minute
CLIP_RATE_LIMIT_DELETE=10/minute

# Brute-force lockout settings
CLIP_MAX_FAILED_ATTEMPTS=5
CLIP_LOCKOUT_SECONDS=300

# Password protection for clips
CLIP_PASSWORD_PROTECTION=true

# ---------- Admin / Monitoring ----------
CLIP_ADMIN_ENABLED=true
CLIP_ADMIN_USERNAME=admin
CLIP_ADMIN_PASSWORD=ChangeThisToAStrongPassword123!  # ⚠️ CHANGE IN PRODUCTION

# ---------- Cache (optional) ----------
# REDIS_URL=redis://localhost:6379/0  # Uncomment for Redis caching (multi-instance)

# ---------- Database (PostgreSQL only, used when CLIP_DB_BACKEND=postgres) ----------
PG_HOST=localhost
PG_PORT=5432
PG_USER=openclipboard
PG_PASSWORD=openclipboard
PG_DATABASE=openclipboard

# ---------- MinIO (only used when CLIP_STORAGE=minio) ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=clipboard
MINIO_SECURE=false
